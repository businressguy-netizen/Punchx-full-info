rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function approvedWorkerApplication(appId) {
      return appId != null
        && exists(/databases/$(database)/documents/workerApplications/$(appId))
        && get(/databases/$(database)/documents/workerApplications/$(appId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/workerApplications/$(appId)).data.status == 'APPROVED';
    }

    function isApprovedWorker() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED'
          || approvedWorkerApplication(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.applicationId)
        );
    }


    // =====================================================
    // SYSTEM CONFIG
    // Client applications must NEVER access admin credentials
    // =====================================================

    match /system_config/{document} {
      allow read, write: if false;
    }


    // =====================================================
    // USER PROFILES
    // BE-03 FIX: Owner-or-admin read access only.
    // Private user data (phone, address, DOB) must not be
    // readable by unrelated authenticated users.
    // Provider discovery uses workerApplications, not users.
    // =====================================================

    match /users/{userId} {

      // BE-03: Only the profile owner or an admin can read user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // A user can create only their own profile.
      // New client-created profiles cannot make themselves admin.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['citizen', 'worker'];

      // Users can update their own profile.
      // Admins can update profiles.
      // The role field cannot be changed by the user.
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'email',
              'phone',
              'address',
              'streetAddress',
              'landmark',
              'avatar',
              'photoURL',
              'location',
              'dob',
              'birthdate',
              'sector',
              'area',
              'city',
              'updatedAt',
              'lastSeen',
              'serviceCategory',
              'visitFee',
              'visitingFee',
              'bio',
              'experience',
              'serviceRadius',
              'serviceRadiusKm',
              'isOnline',
              'workerStatus',
              'workerSkill',
              'workerExperience',
              'workerAvailability',
              'categories',
              'skill',
              'isProfileCompleted',
              'applicationId',
              'status'
            ])
        );

      // Profiles cannot be deleted from the client.
      allow delete: if false;
    }


    // =====================================================
    // WORKER APPLICATIONS
    // BE-01 FIX: Path corrected to camelCase /workerApplications/
    // BE-02 FIX: Client creates are restricted to initial
    // application fields only. Approval state cannot be set
    // by clients.
    // =====================================================

    match /workerApplications/{appId} {

      // Only authenticated users can read applications.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
      );

      // BE-02 FIX: Authenticated users can submit applications,
      // but CANNOT set approval-related fields on create.
      // Status must be 'PENDING' on initial submission.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['legalName','phone','uid'])
        && request.resource.data.status == 'PENDING'
        && !request.resource.data.keys().hasAny([
          'reviewedBy',
          'approvedAt',
          'otpVerified'
        ]);

      // Only admins can approve/reject applications.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'updatedAt',
            'reviewedBy',
            'otpVerified',
            'otpCode',
            'approvedAt',
            'rejectedAt',
            'rejectionReason'
          ]);

      allow delete: if false;
    }


    // =====================================================
    // ORDERS / BOOKINGS
    // BE-06 FIX: Restrict customer and worker updates to
    // only their permitted fields. Ownership, price, payment,
    // and admin-controlled fields are protected.
    // =====================================================

    match /orders/{orderId} {

      // Customers and assigned workers can read their own orders.
      // Approved workers can also read unassigned, dispatchable jobs so
      // the partner panel can present real nearby work while online.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.workerId == request.auth.uid
        || (
          isApprovedWorker()
          && resource.data.workerId == null
          && resource.data.status in ['Pending', 'PAID', 'DISPATCHING']
        )
      );

      // A customer can create only an order belonging to themselves.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'customerId',
          'category'
        ]);

      // BE-06 FIX: Field-level restrictions for updates.
      // Admins can update any field.
      // Customers can only update limited feedback/status fields.
      // Approved workers can claim an unassigned job and then update
      // only operational fields belonging to that job.
      allow update: if signedIn() && (
        isAdmin()
        || (
          resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'arrivalFeedbackSubmitted',
              'arrivalQualityRating',
              'qualityDiscountApplied',
              'prepaidRefundStatus',
              'prepaidRefundAmount',
              'isRated',
              'userRating',
              'userBehaviour',
              'warrantyClaimId',
              'warrantyClaimStatus'
            ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status == 'Cancelled'
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['prepaidRefundAmount', 'qualityDiscountApplied'])
            || (
               request.resource.data.prepaidRefundAmount <= 1000
               && request.resource.data.qualityDiscountApplied <= 1000
            )
          )
        )
        || (
          isApprovedWorker()
          && resource.data.workerId == null
          && request.resource.data.workerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'workerId',
              'workerName',
              'workerPhone',
              'status',
              'acceptedAt',
              'updatedAt',
              'workerOutForWork'
            ])
          && request.resource.data.status in ['ACCEPTED', 'In-Progress', 'In Progress']
        )
        || (
          isApprovedWorker()
          && resource.data.workerId == request.auth.uid
          && request.resource.data.workerId == resource.data.workerId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'completedAt',
              'photoProof',
              'workerLocation',
              'workerOutForWork',
              'updatedAt'
            ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status in ['ACCEPTED', 'In-Progress', 'In Progress', 'EN_ROUTE', 'Enroute', 'ARRIVED', 'Arrived', 'IN_SERVICE', 'SERVICE_STARTED', 'Completed', 'COMPLETED', 'Done']
          )
        )
      );

      // Orders must never be deleted directly from the client.
      allow delete: if false;
    }


    // =====================================================
    // REVIEWS
    // =====================================================

    match /reviews/{reviewId} {

      // Authenticated users can read reviews.
      allow read: if signedIn();

      // Authenticated users can create reviews.
     allow create: if signedIn()
  && request.resource.data.keys().hasAll([
    'orderId',
    'rating'
  ])
  && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
  && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
  && request.resource.data.rating >= 1
  && request.resource.data.rating <= 5;
      // Reviews cannot be changed after creation.
      allow update, delete: if false;
    }


    // =====================================================
    // WARRANTY CLAIMS
    // =====================================================

    match /warranty_claims/{claimId} {

      // Customer/worker involved in the claim or admin.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.workerId == request.auth.uid
      );

      // Authenticated users can submit a claim.
    allow create: if signedIn()
  && request.resource.data.keys().hasAll(['orderId', 'problemDescription'])
  && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
  && (
    (request.resource.data.customerId == request.auth.uid && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid)
    || (request.resource.data.workerId == request.auth.uid && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.workerId == request.auth.uid)
  );
      // Only admins can change claim status/resolution.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'updatedAt',
            'resolution',
            'resolvedAt'
          ]);

      allow delete: if false;
    }


    // =====================================================
    // COMPLAINTS
    // BE-04 FIX: Secure rules for complaints collection.
    // Customers/workers involved can create/read their own.
    // Admins can read and update. Unrelated users denied.
    // =====================================================

    match /complaints/{complaintId} {

      // The customer who filed, or admin, can read a complaint.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
      );

      // Authenticated users can create a complaint for an order they own.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'orderId',
          'customerName',
          'workerName',
          'status'
        ])
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid;

      // Only admins can update complaint status/resolution.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'adminActionNotes',
            'resolvedAt',
            'updatedAt'
          ]);

      // Complaints cannot be deleted from the client.
      allow delete: if false;
    }


    // =====================================================
    // WORKERS
    // BE-05 FIX: Dedicated rules for workers collection.
    // Workers can modify only their own document.
    // Admins can manage. Not publicly writable.
    // =====================================================

    match /workers/{workerId} {

      // Authenticated users can read worker profiles (for provider discovery).
      allow read: if signedIn();

      // A worker can create/update only their own document.
      allow create: if isOwner(workerId);

      allow update: if isOwner(workerId) || isAdmin();

      // Workers cannot be deleted from the client.
      allow delete: if false;
    }


    // =====================================================
    // SERVICE LOCATIONS / HUBS
    // =====================================================

    match /service_locations/{locId} {

      // Authenticated users can view service locations.
      allow read: if signedIn();

      // Only admins can create/update locations.
      allow create, update: if isAdmin();

      allow delete: if false;
    }


    // =====================================================
    // =====================================================
    // DRAGO CONVERSATIONS
    // Private per-user AI memory. Never expose one user's
    // conversation to another user.
    // =====================================================
    match /dragoConversations/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.messages is list;
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.messages is list;
      allow delete: if isOwner(userId) || isAdmin();
    }


    // CATCH-ALL
    // Everything not explicitly allowed above is DENIED.
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
