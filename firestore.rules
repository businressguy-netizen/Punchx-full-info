rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function approvedWorkerApplication(appId) {
      return appId != null
        && exists(/databases/$(database)/documents/workerApplications/$(appId))
        && get(/databases/$(database)/documents/workerApplications/$(appId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/workerApplications/$(appId)).data.status == 'APPROVED';
    }

    function isApprovedWorker() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED'
          || approvedWorkerApplication(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.applicationId)
        );
    }


    // =====================================================
    // SYSTEM CONFIG
    // Client applications must NEVER access admin credentials
    // =====================================================

    match /system_config/{document} {
      allow read, write: if false;
    }


    // =====================================================
    // USER PROFILES
    // BE-03 FIX: Owner-or-admin read access only.
    // Private user data (phone, address, DOB) must not be
    // readable by unrelated authenticated users.
    // Provider discovery uses workerApplications, not users.
    // =====================================================

    match /users/{userId} {

      // BE-03: Only the profile owner or an admin can read user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // A user can create only their own profile.
      // New client-created profiles cannot make themselves admin.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['citizen', 'worker'];

      // Users can update their own profile.
      // Admins can update profiles.
      // The role field cannot be changed by the user.
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'email',
              'phone',
              'address',
              'streetAddress',
              'landmark',
              'avatar',
              'photoURL',
              'location',
              'dob',
              'birthdate',
              'sector',
              'area',
              'city',
              'updatedAt',
              'lastSeen',
              'serviceCategory',
              'visitFee',
              'visitingFee',
              'bio',
              'experience',
              'serviceRadius',
              'serviceRadiusKm',
              'isOnline',
              'workerStatus',
              'workerAvailability',
              'availabilityUpdatedAt',
              'district',
              'state',
              'postalCode',
              'geofenceArea',
              'geofenceAreas',
              'serviceAreas',
              'serviceAreaMode',
              'serviceAreaUpdatedAt',
              'geofenceUpdatedAt',
              'workerSkill',
              'workerCategories',
              'customSkill',
              'workerExperience',
              'categories',
              'skill',
              'isProfileCompleted',
              'applicationId'
            ])
        );

      // Profiles cannot be deleted from the client.
      allow delete: if false;
    }


    // =====================================================
    // WORKER APPLICATIONS
    // Specialist registration & technician discovery.
    // Auto-approval enabled (admin review bypass mode).
    // =====================================================

    match /workerApplications/{appId} {
      // Applications contain identity, contact and address data. Public discovery
      // must use /api/public/professionals, which returns sanitized approved fields.
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Applicants can submit only their own pending application; approval is server/admin-only.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'PENDING')
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'userId', 'legalName', 'dob', 'birthdate', 'address', 'streetAddress',
          'landmark', 'area', 'sector', 'city', 'district', 'state', 'postalCode', 'location',
          'gpsAccuracy', 'lat', 'lng', 'categories', 'skill', 'category', 'customSkill',
          'experienceYears', 'visitingFee', 'price', 'phone', 'email', 'termsAccepted',
          'status', 'appliedAt', 'createdAt', 'updatedAt', 'available', 'avatar', 'photoURL',
          'isOnline', 'workerAvailability', 'workerStatus', 'availabilityUpdatedAt',
          'geofenceArea', 'geofenceAreas', 'serviceAreas', 'serviceAreaMode',
          'serviceAreaUpdatedAt', 'geofenceUpdatedAt'
        ]);

      // Owners may update operational/profile details but cannot change status,
      // verification flags, approval metadata, IDs, or OTP material.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'legalName', 'dob', 'birthdate', 'address', 'streetAddress', 'landmark',
          'area', 'sector', 'city', 'district', 'state', 'postalCode', 'location',
          'gpsAccuracy', 'lat', 'lng', 'categories', 'skill', 'category', 'customSkill',
          'experienceYears', 'visitingFee', 'price', 'phone', 'email', 'avatar', 'photoURL',
          'updatedAt', 'available', 'isOnline', 'workerAvailability', 'workerStatus',
          'availabilityUpdatedAt', 'geofenceArea', 'geofenceAreas', 'serviceAreas',
          'serviceAreaMode', 'serviceAreaUpdatedAt', 'geofenceUpdatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Legacy collection uses the same protection. It is not a public directory.
    match /worker_applications/{appId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'PENDING')
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'userId', 'legalName', 'dob', 'birthdate', 'address', 'streetAddress',
          'landmark', 'area', 'sector', 'city', 'district', 'state', 'postalCode', 'location',
          'gpsAccuracy', 'lat', 'lng', 'categories', 'skill', 'category', 'customSkill',
          'experienceYears', 'visitingFee', 'price', 'phone', 'email', 'termsAccepted',
          'status', 'appliedAt', 'createdAt', 'updatedAt', 'available', 'avatar', 'photoURL',
          'isOnline', 'workerAvailability', 'workerStatus', 'availabilityUpdatedAt',
          'geofenceArea', 'geofenceAreas', 'serviceAreas', 'serviceAreaMode',
          'serviceAreaUpdatedAt', 'geofenceUpdatedAt'
        ]);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'legalName', 'dob', 'birthdate', 'address', 'streetAddress', 'landmark',
          'area', 'sector', 'city', 'district', 'state', 'postalCode', 'location',
          'gpsAccuracy', 'lat', 'lng', 'categories', 'skill', 'category', 'customSkill',
          'experienceYears', 'visitingFee', 'price', 'phone', 'email', 'avatar', 'photoURL',
          'updatedAt', 'available', 'isOnline', 'workerAvailability', 'workerStatus',
          'availabilityUpdatedAt', 'geofenceArea', 'geofenceAreas', 'serviceAreas',
          'serviceAreaMode', 'serviceAreaUpdatedAt', 'geofenceUpdatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // =====================================================
    // ORDERS / BOOKINGS
    // BE-06 FIX: Restrict customer and worker updates to
    // only their permitted fields. Ownership, price, payment,
    // and admin-controlled fields are protected.
    // =====================================================

    match /orders/{orderId} {

      // Customers and assigned workers can read their own orders.
      // Approved workers can also read unassigned, dispatchable jobs so
      // the partner panel can present real nearby work while online.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.workerId == request.auth.uid
        || (
          isApprovedWorker()
          && resource.data.workerId == null
          && resource.data.status in ['Pending', 'DISPATCHING']
        )
      );

      // A customer can create only an order belonging to themselves.
      // Order creation, payment, assignment and status transitions must go through
      // the authenticated server API, which validates pricing and service coverage.
      allow create: if false;

      // Customers may submit only feedback on their own booking. Payment,
      // cancellation, assignment, GPS and lifecycle changes are server-only.
      allow update: if signedIn() && (
        isAdmin()
        || (
          resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'arrivalFeedbackSubmitted',
            'arrivalQualityRating',
            'isRated',
            'userRating',
            'userBehaviour'
          ])
        )
      );

      // Orders must never be deleted directly from the client.
      allow delete: if false;
    }


    // =====================================================
    // REVIEWS
    // =====================================================

    match /reviews/{reviewId} {

      // Authenticated users can read reviews.
      allow read: if signedIn();

      // Authenticated users can create reviews.
     allow create: if signedIn()
  && request.resource.data.keys().hasAll([
    'orderId',
    'rating'
  ])
  && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
  && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
  && request.resource.data.rating >= 1
  && request.resource.data.rating <= 5;
      // Reviews cannot be changed after creation.
      allow update, delete: if false;
    }


    // =====================================================
    // WARRANTY CLAIMS
    // =====================================================

    match /warranty_claims/{claimId} {

      // Customer/worker involved in the claim or admin.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.workerId == request.auth.uid
      );

      // Authenticated users can submit a claim.
    allow create: if signedIn()
  && request.resource.data.keys().hasAll(['orderId', 'problemDescription'])
  && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
  && (
    (request.resource.data.customerId == request.auth.uid && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid)
    || (request.resource.data.workerId == request.auth.uid && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.workerId == request.auth.uid)
  );
      // Only admins can change claim status/resolution.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'updatedAt',
            'resolution',
            'resolvedAt'
          ]);

      allow delete: if false;
    }


    // =====================================================
    // COMPLAINTS
    // BE-04 FIX: Secure rules for complaints collection.
    // Customers/workers involved can create/read their own.
    // Admins can read and update. Unrelated users denied.
    // =====================================================

    match /complaints/{complaintId} {

      // The customer who filed, or admin, can read a complaint.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
      );

      // Authenticated users can create a complaint for an order they own.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'orderId',
          'customerName',
          'workerName',
          'status'
        ])
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid;

      // Only admins can update complaint status/resolution.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'adminActionNotes',
            'resolvedAt',
            'updatedAt'
          ]);

      // Complaints cannot be deleted from the client.
      allow delete: if false;
    }


    // =====================================================
    // WORKERS
    // BE-05 FIX: Dedicated rules for workers collection.
    // Workers can modify only their own document.
    // Admins can manage. Not publicly writable.
    // =====================================================

    match /workers/{workerId} {

      // Authenticated users can read worker profiles (for provider discovery).
      allow read: if signedIn();

      // A worker can create/update only their own document.
      allow create: if isOwner(workerId);

      allow update: if isOwner(workerId) || isAdmin();

      // Workers cannot be deleted from the client.
      allow delete: if false;
    }


    // =====================================================
    // SERVICE LOCATIONS / HUBS
    // =====================================================

    match /service_locations/{locId} {

      // Authenticated users can view service locations.
      allow read: if signedIn();

      // Only admins can create/update locations.
      allow create, update: if isAdmin();

      allow delete: if false;
    }


    // =====================================================
    // =====================================================
    // DRAGO CONVERSATIONS
    // Private per-user AI memory. Never expose one user's
    // conversation to another user.
    // =====================================================
    match /dragoConversations/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.messages is list;
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.messages is list;
      allow delete: if isOwner(userId) || isAdmin();
    }


    // CATCH-ALL
    // Everything not explicitly allowed above is DENIED.
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
