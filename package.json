{
  "name": "punchx-service-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "vite build",
    "start": "node dist/server.cjs",
    "lint": "eslint .",
    "lint:typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "node --test tests/static-seo.test.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google/genai": "^2.4.0",
    "@namoidhq/js": "^3.2.0",
    "@namoidhq/react": "^4.0.0",
    "@vercel/analytics": "^1.2.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "tar": "^7.5.21",
    "undici": "^8.10.2",
    "uuid": "^11.1.1",
    "qs": "^6.16.0",
    "express": {
