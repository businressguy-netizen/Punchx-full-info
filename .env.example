# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PUNCHX DATABASE PROVIDER
# Keep "firebase" until the Supabase connection string is configured and tested.
# Set to "supabase" only after adding SUPABASE_DB_URL in Vercel server environment variables.
PUNCHX_DB_PROVIDER="firebase"
# Use the Supabase PostgreSQL connection pooler URI (server-side secret only).
# Never prefix this variable with VITE_ and never expose it to browser code.
SUPABASE_DB_URL=""

# FIREBASE CONFIGURATION
FIREBASE_PROJECT_ID="gen-lang-client-0120647960"

# GOOGLE MAPS PLATFORM API KEY
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# NAMO ID CONFIGURATION
VITE_NAMOID_CLIENT_ID="namoid_client_live_6SHiIOdLuGIBZmiJjC5Iu5KCbqB2QQjd"
VITE_NAMOID_REDIRECT_URI="https://www.punchxapp.co.in/auth/callback"

# Optional custom backend URL if frontend is decoupled from server
VITE_BACKEND_URL=""

# RAZORPAY — use the public KEY_ID only in the frontend.
# Never put the Razorpay secret key in Vite/frontend environment variables.
VITE_RAZORPAY_KEY_ID=""

# PUNCHX ADMIN COMMAND CENTER DUAL-REPO BRIDGE
ADMIN_API_KEY="" # Set a newly generated secret in server environment only; never commit it.
PORT="3000"

# PUNCHX GPS GEOFENCING (SERVER-SIDE ONLY)
# Leave empty until operations verifies and approves both zone-centre coordinates.
# When approved, set this to a JSON array with two circles:
# - Nabadwip: radiusKm 8, center lat/lng from a verified approved location
# - Kolkata: radiusKm 8, center lat/lng from a verified approved location
# Do not set guessed coordinates. Empty means no zone is active and coverage remains unconfigured.
PUNCHX_GEOFENCE_ZONES=""

# CATEGORY-TARGETED SPONSORED ADS (PUBLIC FRONTEND CONFIG)
# Optional JSON array. Leave empty until a real advertiser campaign is approved.
# Ads only appear when their categoryIds/categoryNames match the customer's selected category.
# Each campaign requires id, advertiser, title, description, targetUrl (https://), and active.
# Optional: imageUrl (https://), ctaLabel, categoryIds, categoryNames, subcategoryNames.
# Example shape (replace with approved campaign details; do not use sample ads in production):
# VITE_PUNCHX_CATEGORY_ADS='[{"id":"campaign-id","advertiser":"Approved advertiser","title":"Offer title","description":"Offer details","targetUrl":"https://advertiser.example/offer","imageUrl":"https://advertiser.example/banner.jpg","ctaLabel":"View offer","categoryNames":["Electrical Services"],"subcategoryNames":["Switches and sockets"],"active":true}]'
VITE_PUNCHX_CATEGORY_ADS=""

